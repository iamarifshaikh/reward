# Copy to .env and fill in. .env is gitignored; .env.example is committed as the key list.
# Anything here can also be supplied as a real environment variable, which is how staging and prod work.

# --- database ---
DB_URL=jdbc:postgresql://localhost:5432/intiq
DB_USERNAME=intiq
DB_PASSWORD=intiq

# --- email: smtp | log ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@intiqrewards.in
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# --- sms: log | msg91 ---
SMS_PROVIDER=log
MSG91_BASE_URL=https://control.msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_OTP_LOGIN=

# --- platform admin seeded by Flyway ---
PLATFORM_ADMIN_EMAIL=shaikharif6190@gmail.com

# --- crypto: generate with `openssl rand -base64 32` and `openssl rand -hex 32` ---
PII_KEY=
OTP_PEPPER=

# --- jwt (blank in dev = ephemeral key generated at startup) ---
JWT_ISSUER=https://api.intiqrewards.in
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
