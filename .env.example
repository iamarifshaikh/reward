DB_URL=jdbc:postgresql://localhost:5432/intiq
DB_USERNAME=intiq
DB_PASSWORD=intiq
PLATFORM_ADMIN_EMAIL=shaikharif6190@gmail.com
PLATFORM_ADMIN_PHONE=+919969763214
PII_KEY=
OTP_PEPPER=
JWT_ISSUER=https://api.intiqrewards.in
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- messaging providers ---
# email: log | ses | smtp    sms: log | msg91    whatsapp: log | msg91
EMAIL_PROVIDER=log
EMAIL_FALLBACK=smtp
SMS_PROVIDER=log
# Leaving this blank on purpose: if MSG91 SMS fails, "log" would make it LOOK like it sent, when
# the OTP is only sitting in a server log the user can't see. Fine for local dev, wrong for prod.
SMS_FALLBACK=
WHATSAPP_PROVIDER=log
WHATSAPP_FALLBACK_CHANNEL=

# --- aws ses: the email provider ---
# No access key/secret here on purpose. The AWS SDK finds credentials itself, in this order:
#   1) AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, if you set them
#   2) ~/.aws/credentials on your machine (what `aws configure` writes)
#   3) the EC2/ECS task role, once this runs in AWS — nothing to set at all
# from-email must be a verified identity in SES (verify it in the SES console first).
AWS_SES_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@intiqrewards.in
SES_FROM_NAME=INTIQ Rewards

# --- smtp: email fallback only, used if SES is down or the sender isn't verified yet ---
EMAIL_FROM=no-reply@intiqrewards.in
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# --- msg91: sms and whatsapp only (email moved to ses above) ---
MSG91_BASE_URL=https://control.msg91.com
MSG91_AUTH_KEY=
# 6-character DLT-approved sender header, e.g. INTIQR — NOT a template id
MSG91_SENDER_ID=
MSG91_SMS_TEMPLATE_OTP_LOGIN=
MSG91_WA_NUMBER=
MSG91_WA_LANGUAGE=en
MSG91_WA_TEMPLATE_OTP_LOGIN=
