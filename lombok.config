# Root marker — stops Lombok from searching parent directories for another config.
config.stopBubbling = true

# Without this, @Qualifier on a field is silently dropped when @RequiredArgsConstructor /
# @AllArgsConstructor generate the constructor, so Spring loses the qualifier and can throw
# "expected single matching bean but found N" even though a @Qualifier is right there in the code.
# See SecurityConfig for the case that surfaced this.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
